#
# Migrate instances created before the volume rework.
#
# Older versions kept the qBittorrent configuration in a bind-mounted host
# directory (CONFIG_DIR) that the backup engine could not reach, and
# described the mounts in a separate volume-qbittorrent.env file. The
# configuration now lives in the qbittorrent-config named volume, and every
# setting lives in the agent environment.
#
# The script is idempotent: a marker file records that the configuration
# has been copied, so a half-finished migration can be retried by running
# update-module again.
#

import os
import shutil
import stat
import subprocess
import sys

import agent
import qbittorrent

STATE_DIR = os.environ['AGENT_STATE_DIR']
LEGACY_ENVFILE = os.path.join(STATE_DIR, "volume-qbittorrent.env")
# Written once the legacy configuration has been copied into the volume.
MIGRATED_MARKER = os.path.join(STATE_DIR, ".config-migrated")
# Dropped by bin/bootstrap-qbittorrent-config on a configuration it created
# from scratch.
SEED_MARKER = ".ns8-seeded"
# MariaDB credentials generated by an old create-module step. qBittorrent
# has never used a database: the file is dead weight holding secrets.
OBSOLETE_FILES = ["database.env", "smarthost.env", "ns8-qbittorrent.sql"]


def volume_mountpoint(name):
    subprocess.run(["podman", "volume", "create", "--ignore", name],
                   check=True, stdout=subprocess.DEVNULL)
    return subprocess.run(
        ["podman", "volume", "inspect", "--format", "{{.Mountpoint}}", name],
        check=True, text=True, capture_output=True,
    ).stdout.strip()


def volume_has_user_data(mountpoint):
    """True when the volume holds a configuration worth protecting.

    An empty volume is obviously free. So is one holding only the
    configuration bin/bootstrap-qbittorrent-config seeds when the service
    starts before this migration gets a chance to run -- that used to make
    the copy below bail out and silently strand the administrator's real
    configuration in the legacy directory. A seeded volume that has since
    collected torrents is a different matter: leave it alone and say so.
    """
    entries = os.listdir(mountpoint)
    if not entries:
        return False
    if SEED_MARKER not in entries:
        return True  # not ours: assume every byte of it matters
    bt_backup = os.path.join(mountpoint, "qBittorrent", "BT_backup")
    try:
        with os.scandir(bt_backup) as it:
            return any(it)
    except FileNotFoundError:
        return False


def migrate_config(legacy_config_dir):
    """Copy the legacy bind-mounted configuration into the named volume."""
    if not legacy_config_dir or not os.path.isdir(legacy_config_dir):
        return
    try:
        mountpoint = volume_mountpoint(qbittorrent.CONFIG_VOLUME)
    except subprocess.CalledProcessError as ex:
        print(f"Cannot create the {qbittorrent.CONFIG_VOLUME} volume: {ex}", file=sys.stderr)
        return
    if volume_has_user_data(mountpoint):
        print(f"WARNING: {qbittorrent.CONFIG_VOLUME} already holds a configuration that is "
              f"not ours, so {legacy_config_dir} was NOT copied over it. The legacy "
              "configuration is still on disk if you need it.", file=sys.stderr)
        return
    if not os.listdir(legacy_config_dir):
        return
    print(f"Copying {legacy_config_dir} into the {qbittorrent.CONFIG_VOLUME} volume",
          file=sys.stderr)
    # The legacy directory is left in place on purpose: it is the only copy
    # of the old configuration, and removing it is the administrator's call.
    shutil.copytree(legacy_config_dir, mountpoint, dirs_exist_ok=True,
                    symlinks=True, ignore=skip_special_files)
    # The volume is no longer a seeded placeholder.
    try:
        os.unlink(os.path.join(mountpoint, SEED_MARKER))
    except FileNotFoundError:
        pass
    with open(MIGRATED_MARKER, "w") as fp:
        fp.write(f"Configuration copied from {legacy_config_dir}\n")


def skip_special_files(src, names):
    """Tell copytree to leave sockets, fifos and device nodes alone.

    copytree copies every entry with copy2, which opens the source: on a
    unix socket that fails with ENXIO and aborts the whole copy.
    qBittorrent keeps a live ipc-socket next to its configuration and
    recreates it on every start, so there is nothing to preserve.
    """
    skipped = set()
    for name in names:
        try:
            mode = os.lstat(os.path.join(src, name)).st_mode
        except OSError:
            skipped.add(name)  # vanished mid-copy, or unreadable
            continue
        if not (stat.S_ISREG(mode) or stat.S_ISDIR(mode) or stat.S_ISLNK(mode)):
            print(f"Skipping special file {os.path.join(src, name)}", file=sys.stderr)
            skipped.add(name)
    return skipped


def main():
    legacy = {}
    if os.path.isfile(LEGACY_ENVFILE):
        legacy = agent.read_envfile(LEGACY_ENVFILE)

    if os.path.exists(MIGRATED_MARKER) or not legacy:
        return 0  # nothing left from the bind-mount era

    # The service may still run with the old unit definition and hold the
    # old bind mounts: stop it before moving data around.
    subprocess.run(["systemctl", "--user", "stop", "ns8-qbittorrent.service"], check=False)

    migrate_config(legacy.get("CONFIG_DIR", ""))

    downloads_dir = legacy.get("DOWNLOADS_DIR", "")
    if qbittorrent.validate_downloads_dir(downloads_dir) is not None:
        if downloads_dir:
            print(f"WARNING: the previous downloads directory {downloads_dir!r} is not usable, "
                  f"switching to the {qbittorrent.DOWNLOADS_VOLUME} volume", file=sys.stderr)
        downloads_dir = ""

    # Start from whatever this instance already has, so re-running the
    # migration cannot undo a setting the administrator has since changed,
    # and only fill in what the bind-mount era knew about.
    settings = qbittorrent.read_settings()
    if not os.environ.get("DOWNLOADS_MOUNT"):
        settings["downloads_dir"] = downloads_dir
        # The BitTorrent port was never opened before this version: keep it
        # closed, so an update never widens the firewall on its own and
        # never binds a host port the administrator did not ask for.
        settings["bt_port_enabled"] = False
    qbittorrent.set_many(qbittorrent.settings_env(settings))

    # WEBUI_PORT was written by an old step but never reached the container.
    qbittorrent.unset_many(["WEBUI_PORT", "CONFIG_DIR", "DOWNLOADS_DIR"])

    for stale in OBSOLETE_FILES + [os.path.basename(LEGACY_ENVFILE)]:
        try:
            os.unlink(os.path.join(STATE_DIR, stale))
            print(f"Removed obsolete {stale}", file=sys.stderr)
        except FileNotFoundError:
            pass

    return 0


sys.exit(main())
