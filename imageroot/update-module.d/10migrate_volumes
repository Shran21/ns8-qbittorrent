#
# Migrate instances created before the volume rework.
#
# Older versions kept the qBittorrent configuration in a bind-mounted host
# directory (CONFIG_DIR) that the backup engine could not reach, and
# described the mounts in a separate volume-qbittorrent.env file. The
# configuration now lives in the qbittorrent-config named volume, and every
# setting lives in the agent environment.
#
# The script is idempotent: it does nothing once the migration is done.
#

import os
import shutil
import subprocess
import sys

import agent
import qbittorrent

STATE_DIR = os.environ['AGENT_STATE_DIR']
LEGACY_ENVFILE = os.path.join(STATE_DIR, "volume-qbittorrent.env")
# MariaDB credentials generated by an old create-module step. qBittorrent
# has never used a database: the file is dead weight holding secrets.
OBSOLETE_FILES = ["database.env", "smarthost.env", "ns8-qbittorrent.sql"]


def volume_mountpoint(name):
    subprocess.run(["podman", "volume", "create", "--ignore", name],
                   check=True, stdout=subprocess.DEVNULL)
    return subprocess.run(
        ["podman", "volume", "inspect", "--format", "{{.Mountpoint}}", name],
        check=True, text=True, capture_output=True,
    ).stdout.strip()


def migrate_config(legacy_config_dir):
    """Copy the legacy bind-mounted configuration into the named volume."""
    if not legacy_config_dir or not os.path.isdir(legacy_config_dir):
        return
    try:
        mountpoint = volume_mountpoint(qbittorrent.CONFIG_VOLUME)
    except subprocess.CalledProcessError as ex:
        print(f"Cannot create the {qbittorrent.CONFIG_VOLUME} volume: {ex}", file=sys.stderr)
        return
    if os.listdir(mountpoint):
        print(f"{qbittorrent.CONFIG_VOLUME} is not empty, skipping the configuration copy",
              file=sys.stderr)
        return
    if not os.listdir(legacy_config_dir):
        return
    print(f"Copying {legacy_config_dir} into the {qbittorrent.CONFIG_VOLUME} volume",
          file=sys.stderr)
    # The legacy directory is left in place on purpose: it is the only copy
    # of the old configuration, and removing it is the administrator's call.
    shutil.copytree(legacy_config_dir, mountpoint, dirs_exist_ok=True, symlinks=True)


def main():
    if os.environ.get("DOWNLOADS_MOUNT"):
        return 0  # already migrated

    legacy = {}
    if os.path.isfile(LEGACY_ENVFILE):
        legacy = agent.read_envfile(LEGACY_ENVFILE)

    # The service still runs with the old unit definition and holds the old
    # bind mounts: stop it before moving data around.
    subprocess.run(["systemctl", "--user", "stop", "ns8-qbittorrent.service"], check=False)

    migrate_config(legacy.get("CONFIG_DIR", ""))

    downloads_dir = legacy.get("DOWNLOADS_DIR", "")
    if qbittorrent.validate_downloads_dir(downloads_dir) is not None:
        if downloads_dir:
            print(f"WARNING: the previous downloads directory {downloads_dir!r} is not usable, "
                  f"switching to the {qbittorrent.DOWNLOADS_VOLUME} volume", file=sys.stderr)
        downloads_dir = ""

    qbittorrent.set_many({
        "DOWNLOADS_MOUNT": qbittorrent.build_downloads_mount(downloads_dir),
        "BT_PORT": str(qbittorrent.DEFAULT_BT_PORT),
        # The BitTorrent port was never opened before this version: keep it
        # closed, so an update never widens the firewall on its own.
        "BT_PORT_ENABLED": "",
        "UMASK": qbittorrent.DEFAULT_UMASK,
        "TZ": qbittorrent.DEFAULT_TZ,
    })

    # WEBUI_PORT was written by an old step but never reached the container.
    qbittorrent.unset_many(["WEBUI_PORT", "CONFIG_DIR", "DOWNLOADS_DIR"])

    for stale in OBSOLETE_FILES + [os.path.basename(LEGACY_ENVFILE)]:
        try:
            os.unlink(os.path.join(STATE_DIR, stale))
            print(f"Removed obsolete {stale}", file=sys.stderr)
        except FileNotFoundError:
            pass

    return 0


sys.exit(main())
