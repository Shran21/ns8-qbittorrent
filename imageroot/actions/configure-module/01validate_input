#
# Validate everything that the JSON schema cannot check on its own: the
# virtual host must be free, the downloads directory must exist and be
# writable, and the BitTorrent port must not be taken by another service.
#

import json
import os
import sys

import agent
import qbittorrent

agent.set_weight(os.path.basename(__file__), 0)  # Validation step, no task progress at all

data = json.load(sys.stdin)
errors = []

host = data.get("host")
# Do not test the host if it did not change: it is already routed to us.
if host != os.environ.get("TRAEFIK_HOST", "") and agent.http_route_in_use(domain=host):
    errors.append({
        "field": "host",
        "parameter": "host",
        "value": host,
        "error": "domain_already_used_in_traefik",
    })

downloads_dir = data.get("downloads_dir", "")
downloads_error = qbittorrent.validate_downloads_dir(downloads_dir)
if downloads_error:
    errors.append({
        "field": "downloads_dir",
        "parameter": "downloads_dir",
        "value": downloads_dir,
        "error": downloads_error,
    })

bt_port = data.get("bt_port", qbittorrent.DEFAULT_BT_PORT)
bt_port_error = qbittorrent.validate_bt_port(bt_port)
if not bt_port_error and bt_port != int(os.environ.get("BT_PORT", 0)):
    # Skip the check when the port did not change: our own running
    # container is holding it, and it would always look busy.
    if agent.tcp_port_in_use(bt_port):
        bt_port_error = "bt_port_in_use"
if bt_port_error:
    errors.append({
        "field": "bt_port",
        "parameter": "bt_port",
        "value": bt_port,
        "error": bt_port_error,
    })

if errors:
    agent.set_status('validation-failed')
    json.dump(errors, fp=sys.stdout)
    sys.exit(2)
