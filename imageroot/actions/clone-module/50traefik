#
# Re-apply the configuration inherited from the source instance.
#

import os
import sys

import agent
import agent.tasks
import qbittorrent

settings = qbittorrent.read_settings()

# Two instances cannot listen on the same BitTorrent port, and the clone
# has no say over which one wins: leave the port closed and let the
# administrator pick a free one from the Settings page.
if qbittorrent.port_in_use(settings['bt_port']):
    print(
        f"WARNING: BitTorrent port {settings['bt_port']} is already in use on this node. "
        "The clone starts with the port closed: choose a free one from the Settings page.",
        file=sys.stderr,
    )
    settings['bt_port_enabled'] = False

configure_retval = agent.tasks.run(
    agent_id=os.environ['AGENT_ID'],
    action='configure-module',
    data=settings,
)
agent.assert_exp(configure_retval['exit_code'] == 0, "The configure-module subtask failed!")
