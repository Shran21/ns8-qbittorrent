#
# Release the resources this module holds on the node: the Traefik route
# and the firewall port.
#

import os

import agent
import agent.tasks

module_id = os.environ['MODULE_ID']

# Errors are ignored on purpose: a module being removed must not be left
# half-destroyed because a cleanup step failed.
agent.remove_public_service(module_id)

default_traefik_id = agent.resolve_agent_id('traefik@node')
if default_traefik_id is not None:
    response = agent.tasks.run(
        agent_id=default_traefik_id,
        action='delete-route',
        data={'instance': module_id},
    )
    agent.assert_exp(response['exit_code'] == 0)
