#
# This systemd unit creates the Podman pod that hosts the qBittorrent
# container and publishes its ports.
#
# The WebUI port is bound to the loopback address only: it is reachable
# through the Traefik virtual host configured by `configure-module`.
#
# The BitTorrent listen port is bound to every address, because incoming
# peer connections must reach it from the outside. $BT_PUBLISH carries the
# publish arguments and is empty when the port is disabled, so the host
# port is not bound at all: a clone or a migrated instance can start while
# the original still holds that port. It is unbraced on purpose -- systemd
# splits $VAR on whitespace, while ${VAR} would stay a single argument.
#

[Unit]
Description=Podman ns8-qbittorrent.service
Requires=qbittorrent-app.service
Before=qbittorrent-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/ns8-qbittorrent.pid %t/ns8-qbittorrent.pod-id
ExecStartPre=/usr/bin/podman pod create \
    --infra-conmon-pidfile=%t/ns8-qbittorrent.pid \
    --pod-id-file=%t/ns8-qbittorrent.pod-id \
    --name=ns8-qbittorrent \
    --publish=127.0.0.1:${TCP_PORT}:8080 \
    $BT_PUBLISH \
    --replace
ExecStart=/usr/bin/podman pod start --pod-id-file %t/ns8-qbittorrent.pod-id
ExecStop=/usr/bin/podman pod stop --ignore --pod-id-file %t/ns8-qbittorrent.pod-id -t 10
ExecStopPost=/usr/bin/podman pod rm --ignore -f --pod-id-file %t/ns8-qbittorrent.pod-id
PIDFile=%t/ns8-qbittorrent.pid
Type=forking

[Install]
WantedBy=default.target
